YCM_APP_NAME=YouTube Upload Manager
YCM_ENVIRONMENT=development
YCM_DATABASE_URL=postgresql+psycopg2://ycm:ycm@postgres:5432/ycm
YCM_REDIS_URL=redis://redis:6379/0
YCM_VIDEO_ROOT=/srv/ycm/inbox
YCM_ARTIFACTS_ROOT=/srv/ycm/artifacts
YCM_CUTS_ROOT=/srv/ycm/artifacts/cuts
YCM_TRANSCRIPTS_ROOT=/srv/ycm/artifacts/transcripts
YCM_SCHEDULER_SCAN_INTERVAL_SECONDS=300

YCM_DEFAULT_LANGUAGE=pt-BR
YCM_DEFAULT_MODEL_PROVIDER=ollama
YCM_LOG_LEVEL=INFO
YCM_LOG_JSON=false

# Ollama (local LLM) --------------------------------------------------------
YCM_OLLAMA_BASE_URL=http://192.168.1.182:11434
YCM_OLLAMA_MODEL=gemma4:26b
YCM_OLLAMA_TIMEOUT_SECONDS=120
YCM_OLLAMA_ENABLED=true

# Whisper (Speech-to-Text) --------------------------------------------------
YCM_WHISPER_ENABLED=true
YCM_WHISPER_MODEL=small
YCM_WHISPER_DEVICE=auto
YCM_WHISPER_COMPUTE_TYPE=auto
YCM_WHISPER_LANGUAGE=pt
YCM_WHISPER_AUTO_RUN=true

YCM_TELEGRAM_WEBHOOK_SECRET=change-me
YCM_API_TOKEN=

YCM_YOUTUBE_CHANNEL_ID=
YCM_YOUTUBE_CLIENT_ID=
YCM_YOUTUBE_CLIENT_SECRET=
YCM_YOUTUBE_REDIRECT_URI=http://localhost:8000/ui/youtube/oauth/callback
YCM_YOUTUBE_TOKEN_FILE=./data/youtube_token.json

YCM_STEAM_API_KEY=
YCM_STEAM_DOMAIN=localhost
YCM_STEAM_ID=
YCM_STEAM_CACHE_TTL_SECONDS=180
YCM_N8N_WEBHOOK_URL=

# Backward-compatible plain env keys
STEAM_API_KEY=
STEAM_DOMAIN=localhost
STEAM_ID=
N8N_WEBHOOK_URL=

# YouTube OAuth2 (set these, then set DRY_RUN=false)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
DRY_RUN=true
YCM_DRY_RUN=true

# Legacy / optional provider key
OPENCLOUD_API_KEY=

POSTGRES_DB=ycm
POSTGRES_USER=ycm
POSTGRES_PASSWORD=ycm
